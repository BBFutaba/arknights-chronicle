# 游戏解包数据和 PRTS 缓存（体积大，版权属于原作者，只留在本地）
data/raw/
# 中间产物和网页数据，可由 pipeline 重新生成；网页数据含剧本全文，不要提交
data/structured/
site/data/
.obsidian/
__pycache__/
*.pyc
# 编年史成品（含剧本原文），由 python -m pipeline.annals render 生成
/annals/
# 游戏原文的本地副本（TXT/EPUB/PDF，约 5GB，版权属于原作者）
StoryText/
# 公开版网页，由 python -m pipeline.publish 生成，部署到 gh-pages 分支
/dist/
# 单文件版，由 python -m pipeline.bundle 生成，都不进仓库。
# 刻舟录-x.x.html 是本地版，含剧本全文，不要上传；刻舟录-Ox.x.html 是发行版，传到 GitHub Release
/刻舟录-*.html
# 用户放进来的素材（设定集等，版权属于原作者），只留本地，不要上传
Raw Data/
